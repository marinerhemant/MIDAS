# Copy this folder to experiments/<your_experiment>/ and fill it in. Every value is a FACT about the beamtime:
# say where it came from in the comment. Nothing here is guessed by the kit.
GROUP="<dm-group-of-the-experiment>"                 # `id | grep <group>` must succeed for read access
RAW="/gdata/dm/20ID/HT_HEDM/<cycle>/<experiment>/data"   # contains varexD/ gh1s/ metadata/ ...
# Detector / station conventions (ff-hedm manual README, "Station conventions"). 20-ID-D HT-HEDM Varex:
NPIX=2880
PX_UM=150
IMTRANS=2            # flip-Z. 20-ID-D, established from the beamstop arm (argument 2); re-check per beamtime
OMEGA_SIGN=negate    # aero stage turns clockwise: OmegaStart 180 / OmegaStep -0.25. Say who verified it and how
                     #   (e.g. "verified physically at the beamline by the PI on <date>"; the mirror IMTRANS is a separate fact)
SKIPFRAME=1          # frame 0 of every sweep is a throwaway
# Beam energy is NOT recorded in 20-ID files (ENVELOPE section 1): it is an ASSERTION. Say who asserted it, and read the
# beamtime explog: file names carry the nominal energy, not the absorption-edge value actually used.
ENERGY_KEV=
ENERGY_SOURCE="<who/where>"
LSD_MM=              # nominal sample-detector distance of the scans; the calibration gives the real one
# The sample's phases. PRIMARY = the dominant phase whose lines you mask when hunting; TARGET = the phase you want grains of.
PRIMARY_NAME="<e.g. NMC>"
PRIMARY_SG="<space group number>"
PRIMARY_LAT="<a b c alpha beta gamma>"
TARGET_NAME="<e.g. LPSC>"
TARGET_SG="<space group number>"
TARGET_LAT="<a b c alpha beta gamma>"              # literature cell; refine it from the grains afterwards
TARGET_CIF=                                         # optional path to a CIF (atom basis only; the cell comes from the run). Do NOT put a
                                                    # licensed (ICSD) CIF in a shared folder: keep the path on your own disk
# Calibration (kit calib/run_cali.sh writes $WORK/calib/<tag>/ps_calibrated.txt). Calibrate at the REAL energy above.
CAL_IMAGES=""        # "tag:/abs/path/to/calibrant_file.h5 tag2:/abs/path2 ..." CeO2 or LaB6 files at this energy and distance
CAL_PARAMS=          # the ps_calibrated.txt you chose for the sample runs
# Scan folders to hunt/index: CSV with columns name,folder,energy_keV,lsd_mm (see tools/phase_hunt_all.py)
SAMPLES_CSV=
